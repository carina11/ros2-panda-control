<root main_tree_to_execute="seq5_prox_all">
  <BehaviorTree ID="seq5_prox_all">
    <Sequence name="Approach Phase">
      <MoveArmAction joint_angles="{start_joints}"/>
      <GripperAction finger1="0.015" finger2="0.015"/>
      <Sequence name="Approach_Prox">
        <Sequence name="Multi_stage_approach">
          <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.9" velocity_scale="0.9"/>
          <MoveArmAction joint_angles="{give_object_prox1}" accel_scale="0.8" velocity_scale="0.8"/>
          <SleepAction duration="3.0"/>
          <MoveArmAction joint_angles="{give_object_prox2}" accel_scale="0.3" velocity_scale="0.3"/>
        </Sequence>
        <Sequence name="Shift_Towards_Human">
          <MoveArmAction joint_angles="{give_object_prox1}" accel_scale="0.8" velocity_scale="0.8"/>
          <MoveArmAction joint_angles="{give_object_prox2}" accel_scale="0.3" velocity_scale="0.3"/>
          <SleepAction duration="3.0"/>
          <MoveArmAction joint_angles="{give_object_prox_nod}" accel_scale="0.3" velocity_scale="0.3"/>
          <SleepAction duration="5.0"/>
        </Sequence>
        <Sequence name="straigt_line">
          <MoveArmAction joint_angles="{start_joints}" accel_scale="0.9" velocity_scale="0.9"/>
          <SleepAction duration="2.0"/>
          <MoveArmAction joint_angles="{give_object_prox_straight}" accel_scale="0.1" velocity_scale="0.1"/>
          <SleepAction duration="3.0"/>
        </Sequence>
        <Sequence name="Predtictable_line">
          <MoveArmAction joint_angles="{start_joints}" accel_scale="0.7" velocity_scale="0.7"/>
          <MoveArmAction joint_angles="{before_half_straight_arm}" accel_scale="0.7" velocity_scale="0.7"/>
          <MoveArmAction joint_angles="{half_straight_arm}" accel_scale="0.3" velocity_scale="0.3"/>
          <SleepAction duration="3.0"/>
        </Sequence>
        <Sequence name="arm_extend">
          <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.7" velocity_scale="0.7"/>
          <GripperAction finger1="0.015" finger2="0.015" gripper_time="1.5"/> <!-- Objekt loslassen -->
          <SleepAction duration="5.0"/>
          <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.7" velocity_scale="0.7"/>
          <MoveArmAction joint_angles="{straight_arm}" accel_scale="0.3" velocity_scale="0.3"/>
          <SleepAction duration="3.0"/>
        </Sequence>
      </Sequence>
      <Sequence name="Withhold_Signal">
        <MoveArmAction joint_angles="{start_joints}"/>
        <MoveArmAction joint_angles="{kinesics_nearer}" velocity_scale="0.5" accel_scale="0.5"/>
        <MoveArmAction joint_angles="{Halt}" velocity_scale="0.9" accel_scale="0.9"/>
        <SleepAction duration="3.0"/>
        <MoveArmAction joint_angles="{kinesics_handover}" velocity_scale="0.4" accel_scale="0.4"/>
        <SleepAction duration="5.0"/>
      </Sequence>
      <Sequence name="Retreat_signals">
        <Sequence name="Back_To_Gaze">
          <MoveArmAction joint_angles="{start_joints}"/>
          <MoveArmAction joint_angles="{give_object_prox_straight}" accel_scale="0.1" velocity_scale="0.1"/>
          <MoveArmAction joint_angles="{gaze}"/>
        </Sequence>
        <Sequence name="2_Phase">
          <MoveArmAction joint_angles="{give_object_prox2}" accel_scale="0.1" velocity_scale="0.1"/>
          <SleepAction duration="2.0"/>
          <MoveArmAction joint_angles="{give_object_prox1}" accel_scale="0.8" velocity_scale="0.8"/>
          <MoveArmAction joint_angles="{start_joints}"/>
        </Sequence>
      </Sequence>
    </Sequence>
  </BehaviorTree>
</root>   