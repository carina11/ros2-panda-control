<!-- Jede Proxemics Bewegung eines Handover aufgeteilt in davor-während-danach -->

<root main_tree_to_execute="seq7_prox">
  <BehaviorTree ID="seq7_prox">
    <Sequence name="sequence_proxemics_handover">

      <Sequence name="before_handover_proxemics">
        <MoveArmAction state_name="ready"/>
        <GripperAction finger1="0.0" finger2="0.0"/>
        <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.5" velocity_scale="0.5"/> 
        <MoveArmAction joint_angles="{gaze}" accel_scale="0.9" velocity_scale="0.9"/>
        <SleepAction duration="3.0"/>  <!-- 3 Sekunden warten -->
        <MoveArmAction joint_angles="{nod_joints}" accel_scale="0.7" velocity_scale="0.7"/>
        <MoveArmAction joint_angles="{gaze}" accel_scale="0.9" velocity_scale="0.9"/>
        <SleepAction duration="3.0"/>  <!-- 3 Sekunden warten -->
        <MoveArmAction joint_angles="{start_joints}" accel_scale="0.7" velocity_scale="0.7"/>
        <SleepAction duration="2.0"/>         
        <MoveArmAction joint_angles="{gaze_head}" accel_scale="0.9" velocity_scale="0.9"/>
        <SleepAction duration="4.0"/>
        <MoveArmAction joint_angles="{start_joints}" accel_scale="0.7" velocity_scale="0.7"/>    
      </Sequence>

      <Sequence name="take_object">
        <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.7" velocity_scale="0.7"/>
        <GripperAction finger1="0.03" finger2="0.03"/>
        <SleepAction duration="2.0"/>
        <GripperAction finger1="0.015" finger2="0.015" gripper_time="0.5"/> <!-- Objekt greifen -->
      </Sequence>

      <Sequence name="pre_handover_proxemics">
        <Sequence name="two_steps_approach">
          <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.7" velocity_scale="0.7"/>
          <MoveArmAction joint_angles="{give_object_prox1}" accel_scale="0.5" velocity_scale="0.5"/>
          <SleepAction duration="5.0"/> <!-- Wait until human gaze is detected-->
          <MoveArmAction joint_angles="{give_object_prox2}" accel_scale="0.1" velocity_scale="0.1"/> <!--Move to Human-->
          <GripperAction finger1="0.035" finger2="0.035" gripper_time="1.5"/> <!-- Objekt loslassen -->
          <SleepAction duration="3.0"/>  <!-- 3 Sekunden warten -->
        </Sequence>
        <Sequence name="arm_approach">
          <Sequence name="half_extend">
            <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.7" velocity_scale="0.7"/>
            <GripperAction finger1="0.015" finger2="0.015" gripper_time="1.5"/> <!-- Objekt loslassen -->
            <MoveArmAction joint_angles="{before_half_straight_arm}" accel_scale="0.7" velocity_scale="0.7"/>
            <SleepAction duration="1.0"/>
            <MoveArmAction joint_angles="{half_straight_arm}" accel_scale="0.3" velocity_scale="0.3"/>
            <GripperAction finger1="0.03" finger2="0.03" gripper_time="0.5"/> <!-- Release Object -->
            <SleepAction duration="5.0"/>
          </Sequence>
          <Sequence name="arm_extend">
            <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.7" velocity_scale="0.7"/>
            <GripperAction finger1="0.015" finger2="0.015" gripper_time="1.5"/> <!-- Objekt loslassen -->
            <SleepAction duration="5.0"/>
            <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.7" velocity_scale="0.7"/>
            <MoveArmAction joint_angles="{straight_arm}" accel_scale="0.3" velocity_scale="0.3"/>
          </Sequence>
        </Sequence>
      </Sequence>

    </Sequence>
  </BehaviorTree>
</root>