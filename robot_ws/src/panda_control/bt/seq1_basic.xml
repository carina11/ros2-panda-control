<!-- Basic Ausführung eines Handovers ohne Proxemics/Kinesics -->
<root main_tree_to_execute="seq1_basic">
  <BehaviorTree ID="seq1_basic">
    <Sequence name="sequence_handover_Basic">
         <MoveArmAction joint_angles="{start_joints}"/>
         <GripperAction finger1="0.03" finger2="0.03"/> <!-- Objekt greifen -->
         <GripperAction finger1="0.015" finger2="0.015" gripper_time="0.5"/>  <!-- Objekt greifen -->
         <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.5" velocity_scale="0.5"/>
          <SleepAction duration="2.0"/>  <!-- 3 Sekunden warten -->
          <MoveArmAction joint_angles="{basic_handover_joints}" accel_scale="0.5" velocity_scale="0.5"/>   
          <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
          <GripperAction finger1="0.035" finger2="0.035" gripper_time="1.5"/> <!-- Objekt loslassen -->
          <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
          <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.5" velocity_scale="0.5"/>
          <GripperAction finger1="0.00" finger2="0.00" gripper_time="0.5"/>
          <MoveArmAction joint_angles="{start_joints}" velocity_scale="0.5" accel_scale="0.5"/>
    </Sequence>
  </BehaviorTree>
</root>


