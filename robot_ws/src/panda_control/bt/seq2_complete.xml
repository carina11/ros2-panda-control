
<root main_tree_to_execute="sequence2_complete">
  <BehaviorTree ID="sequence2_complete">
    <Sequence name="sequence_kinesics">
      <Sequence name="Aufmerksamkeit_Human">
        <MoveArmAction joint_angles="{start_joints}"/>
        <MoveArmAction joint_angles="{nod_joints_nearer}" velocity_scale="0.9" accel_scale="0.9"/>
        <SleepAction duration="3.0"/>  <!--Warte auf Aufgabenbeschreibung, Watching -->
      </Sequence>
      <!--Andere Gelenke für Nod , näher an "Ursprungsposition", Bewegungsradius verkleinert-->
      <Sequence name="Head_Nod">
        <Repeat num_cycles="3">
          <Sequence>
            <MoveArmAction joint_angles="{nod_joints_nearer}" velocity_scale="0.9" accel_scale="0.9"/>
            <MoveArmAction joint_angles="{nod_joints2_nearer}" velocity_scale="0.9" accel_scale="0.9"/>
          </Sequence>
        </Repeat>
      </Sequence> 
      <Sequence name="Abholen">
        <MoveArmAction joint_angles="{bend_forward_joints}" velocity_scale="0.8" accel_scale="0.8"/>
        <MoveArmAction joint_angles="{search_joints_right}" velocity_scale="0.4" accel_scale="0.8"/>
        <MoveArmAction joint_angles="{search_joints_left}" velocity_scale="0.4" accel_scale="0.8"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <Repeat num_cycles="2"> <!--Ist das DIESES Objekt ? -->
          <Sequence>
            <MoveArmAction joint_angles="{this_object}" velocity_scale="0.5" accel_scale="1.0"/>
            <MoveArmAction joint_angles="{bend_forward_joints}" velocity_scale="1.0" accel_scale="1.0"/>
          </Sequence>
        </Repeat>
        <SleepAction duration="1.0"/>  <!-- 3 Sekunden warten, Auf JA/NEIN warten -->
        <MoveArmAction joint_angles="{bend_forward_joints_nod}" velocity_scale="0.8" accel_scale="0.8"/>
        <MoveArmAction joint_angles="{bend_forward_joints}" velocity_scale="0.8" accel_scale="0.8"/>
        <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.7" velocity_scale="0.7"/>
        <GripperAction finger1="0.03" finger2="0.03"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <GripperAction finger1="0.015" finger2="0.015" gripper_time="0.5"/> <!-- Objekt greifen -->
        <MoveArmAction joint_angles="{rotate_left_joints}" velocity_scale="0.5" accel_scale="1.0"/>
        <MoveArmAction joint_angles="{take_object_kinesics}" velocity_scale="0.5" accel_scale="0.5"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <MoveArmAction joint_angles="{take_object_kinesics_erweitert}" velocity_scale="0.3" accel_scale="0.3"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <GripperAction finger1="0.035" finger2="0.035" gripper_time="1.5"/> <!-- Objekt loslassen -->
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <GripperAction finger1="0.00" finger2="0.00" gripper_time="0.5"/> 
        <MoveArmAction joint_angles="{nod_joints_nearer}" accel_scale="0.5" velocity_scale="0.5"/> 
        <SleepAction duration="4.0"/>  <!-- Warten Auf Rückmeldung/Befehl zum Ende Der Aktion -->
        <MoveArmAction joint_angles="{start_joints}" velocity_scale="0.5" accel_scale="0.5"/>
        </Sequence>
    </Sequence>
  </BehaviorTree>
</root>