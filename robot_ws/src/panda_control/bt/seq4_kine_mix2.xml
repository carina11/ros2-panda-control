<root main_tree_to_execute="seq5_kine"> 
  <BehaviorTree ID="seq5_kine">
    <Sequence name="sequence_kinesics_handover2">
      <Sequence name="start">
        <MoveArmAction joint_angles="{start_joints}"/>
        <GripperAction finger1="0.0" finger2="0.0"/> <!-- Objekt greifen -->
        <MoveArmAction joint_angles="{gaze}" accel_scale="0.9" velocity_scale="0.9"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <MoveArmAction joint_angles="{irritation_head}" accel_scale="0.9" velocity_scale="0.9"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <MoveArmAction joint_angles="{gaze}" accel_scale="0.5" velocity_scale="0.1"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <Repeat num_cycles="2">
            <Sequence>
              <MoveArmAction joint_angles="{nod_joints}" accel_scale="0.5" velocity_scale="0.5"/>
              <MoveArmAction joint_angles="{gaze}" accel_scale="0.5" velocity_scale="0.5"/>
            </Sequence>
        </Repeat>
      </Sequence>

      <Sequence name="take_object_kinesics">
        <MoveArmAction joint_angles="{start_joints}" accel_scale="0.7" velocity_scale="0.7"/>
        <MoveArmAction joint_angles="{search_joints_right}" accel_scale="0.4" velocity_scale="0.1"/>
        <MoveArmAction joint_angles="{search_joints_left}" accel_scale="0.4" velocity_scale="0.1"/>
        <MoveArmAction joint_angles="{start_joints}" accel_scale="0.8" velocity_scale="0.5"/>
        <Repeat num_cycles="2">
          <Sequence>
            <MoveArmAction joint_angles="{this_object}" accel_scale="0.5" velocity_scale="0.5"/>
            <MoveArmAction joint_angles="{start_joints}" accel_scale="0.8" velocity_scale="0.5"/>
          </Sequence>
        </Repeat>
        <MoveArmAction joint_angles="{gaze_head}" accel_scale="0.7" velocity_scale="0.7"/>
        <SleepAction duration="2.0"/>
        <MoveArmAction joint_angles="{take_object_joints}" accel_scale="0.4" velocity_scale="0.4"/>
        <SleepAction duration="1.0"/>
        <GripperAction finger1="0.03" finger2="0.03"/>
        <SleepAction duration="2.0"/>
        <GripperAction finger1="0.015" finger2="0.015" gripper_time="0.5"/> <!-- Objekt greifen -->
        <MoveArmAction joint_angles="{rotate_left_joints}" accel_scale="0.7" velocity_scale="0.7"/>
     </Sequence>

      <Sequence name="handover">
        <MoveArmAction joint_angles="{kinesics_nearer}" velocity_scale="0.5" accel_scale="0.5"/>
        <MoveArmAction joint_angles="{halt}" velocity_scale="0.9" accel_scale="0.9"/>
        <SleepAction duration="3.0"/> 
        <MoveArmAction joint_angles="{kinesics_handover}" velocity_scale="0.4" accel_scale="0.4"/> 
        <SleepAction duration="5.0"/>  
        <MoveArmAction joint_angles="{palm_presenting}" accel_scale="0.2" velocity_scale="0.2"/>
        <SleepAction duration="3.0"/>
        <GripperAction finger1="0.035" finger2="0.035" gripper_time="0.5"/>
        <SleepAction duration="2.0"/> 
        <MoveArmAction joint_angles="{gaze}" velocity_scale="0.9" accel_scale="0.9"/>
        <SleepAction duration="2.0"/>  <!-- 2 Sekunden warten -->
        <MoveArmAction joint_angles="{nod_joints}" velocity_scale="0.9" accel_scale="0.9"/>
        <MoveArmAction joint_angles="{start_joints}" velocity_scale="0.5" accel_scale="0.5"/>
      </Sequence>

    </Sequence>
  </BehaviorTree>
</root>